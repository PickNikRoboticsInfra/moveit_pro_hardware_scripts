[Unit]
Description=MoveIt Pro
After=network-online.target docker.service
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=%i
EnvironmentFile=-/etc/default/moveit-pro
ExecStart=/usr/local/sbin/moveit-pro-run
ExecStop=/usr/bin/moveit_pro down
KillMode=mixed
TimeoutStopSec=60
Restart=no
ExecStopPost=-/usr/bin/notify-crash.py moveit-pro@%i.service

[Install]
WantedBy=multi-user.target
